# --- Stata ---
*.log
*.smcl
*.dta
*.gph

# Preserve local folder structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/final/.gitkeep
!data/README.md
!output/tables/.gitkeep
!output/figures/.gitkeep
!output/logs/.gitkeep
!output/README.md

# --- Output ---
output/tables/*
output/figures/*
output/logs/*

# But keep empty folders
!output/tables/.gitkeep
!output/figures/.gitkeep
!output/logs/.gitkeep
!output/README.md

# --- LaTeX ---
*.aux
*.bbl
*.blg
*.synctex.gz
*.toc
*.out
*.fdb_latexmk
*.fls

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
*.tmp
*.swp
*.bak
.Rhistory
.RData
.Rproj.user/
.Rproj

# --- RStudio / Quarto (if ever added) ---
.Rproj.user/
*.Rhistory
*.RData
*.Rproj

# --- Python cache ---
__pycache__/
*.pyc
